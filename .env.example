# ==========================================
# Mural Search - Configuration Environment
# ==========================================

# Application
APP_NAME="Mural Search"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database (Default: local SQLite with async aiosqlite driver)
DATABASE_URL="sqlite+aiosqlite:///./data/mural_search.db"

# Storage & Cache
CACHE_DIR="./data/cache"
MAX_CACHE_SIZE_MB=5000

# Device Acceleration (auto | mps | cuda | cpu)
DEVICE_PREFERENCE="auto"

# Active Provider Selections
GEODATA_PROVIDER=osm
IMAGERY_PROVIDER=mapillary
VISION_RANKER_PROVIDER=mock
VISION_ANALYZER_PROVIDER=mock
EXPOSURE_PROVIDER=none

# Optional Cloud / API Provider Keys (for future phases)
MAPILLARY_CLIENT_TOKEN=""
OPENAI_API_KEY=""
OPENAI_ENABLED=false
OPENAI_MODEL="gpt-4o-mini"

# Scoring Engine Weights (must sum to 1.0)
WEIGHT_WALL=0.30
WEIGHT_BLANKNESS=0.25
WEIGHT_VISIBILITY=0.20
WEIGHT_ACCESSIBILITY=0.15
WEIGHT_CONFIDENCE=0.10

# CORS Allowed Origins
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'
